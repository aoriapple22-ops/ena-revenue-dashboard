# Supabase 프로젝트 설정 (앱이 실제로 사용하는 값)
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출되므로 공개 가능한 값만 넣습니다.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# 사이트 접속 비밀번호 (서버에서만 사용 — NEXT_PUBLIC_ 접두사 금지)
# 값이 비어 있으면 비밀번호 보호가 꺼집니다 (로컬 개발용).
SITE_PASSWORD=<접속 비밀번호>

# 로그인 쿠키 서명용 키 (임의의 긴 문자열)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=<랜덤 시크릿>
